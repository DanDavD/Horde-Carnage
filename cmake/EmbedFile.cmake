# horde_embed_file(<target> <file> <symbol>)
#
# Compiles the bytes of <file> into <target> as `const unsigned char <symbol>[]` and
# `const std::size_t <symbol>Size` in namespace horde. The game carries its fonts this way, so the desktop zip
# stays one executable and the browser build needs no file system.
#
# The source is written at configure time, and only when the bytes changed, so an unchanged font never
# triggers a rebuild. CMake configures again by itself if the file changes.
function(horde_embed_file target file symbol)
    file(READ "${file}" hex HEX)
    # 16 bytes per line keeps the lines short for every compiler.
    string(REPEAT "[0-9a-f][0-9a-f]" 16 line_pattern)
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REPLACE "\n" "\n    " bytes "${bytes}")
    get_filename_component(name "${file}" NAME)

    set(source "${CMAKE_CURRENT_BINARY_DIR}/embedded/${symbol}.cpp")
    file(WRITE "${source}.new"
        "// Generated by cmake/EmbedFile.cmake from ${name}. Do not edit.\n"
        "#include <cstddef>\n\n"
        "namespace horde {\n\n"
        "extern const unsigned char ${symbol}[];\n"
        "extern const std::size_t ${symbol}Size;\n\n"
        "const unsigned char ${symbol}[] = {\n    ${bytes}\n};\n"
        "const std::size_t ${symbol}Size = sizeof(${symbol});\n\n"
        "} // namespace horde\n")
    file(COPY_FILE "${source}.new" "${source}" ONLY_IF_DIFFERENT)
    file(REMOVE "${source}.new")

    target_sources(${target} PRIVATE "${source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
endfunction()
